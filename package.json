{
  "name": "interview-prep-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turns a job description into a researched, editable interview preparation kit.",
  "engines": { "node": ">=22.12.0" },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/cli",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "evaluate": "tsx packages/cli/src/evaluate.ts",
    "fixtures:serve": "tsx packages/core/test/support/serveFixtures.ts",
    "dev": "run-p dev:api dev:web",
    "dev:api": "npm run dev --workspace @kit/api",
    "dev:web": "npm run dev --workspace @kit/web",
    "build": "run-s build:api build:web",
    "build:api": "npm run build --workspace @kit/api",
    "build:web": "npm run build --workspace @kit/web",
    "start": "node packages/api/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:env": "tsx scripts/check-env.ts",
    "check:layers": "tsx scripts/check-layers.ts",
    "validate:kits": "tsx scripts/validate-kits.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
