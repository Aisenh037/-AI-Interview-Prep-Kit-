# ---------------------------------------------------------------------------
# AI Interview Prep Kit — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# THE BATCH ENTRY POINT NEEDS ONLY ONE VARIABLE: GROQ_API_KEY.
# No MongoDB, no auth secret and no search key are required to run:
#   npm run evaluate -- --input examples/cases.sample.json --output out/kits.json
# ---------------------------------------------------------------------------

# --- Language model -------------------------------------------------------
# Provider adapter to use: groq | gemini | openai-compatible | fixture
LLM_PROVIDER=groq
# REQUIRED FOR A REAL RUN. Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Primary model for quality-critical calls (extraction, question generation).
# Free-tier limits are enforced PER MODEL, so the router spreads load across all
# three of these to multiply the available tokens-per-minute.
LLM_MODEL=openai/gpt-oss-120b
# Cheap model for mechanical calls (link re-ranking, gap fill, JSON repair).
LLM_MODEL_FAST=openai/gpt-oss-20b
# Third bucket, used when the first two are rate-limited.
LLM_MODEL_OVERFLOW=qwen/qwen3.8-27b
# Per-call ceiling. gpt-oss models are reasoning models: reasoning tokens are
# billed as output, so this must be generous or strict JSON decoding fails.
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_MS=45000

# Optional second provider. If set, fat calls can fail over to it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Public-discussion search --------------------------------------------
# Hacker News Algolia is keyless and always available, so search works with no
# setup. Adding a key below upgrades result quality but is never required.
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- Retrieval ------------------------------------------------------------
CRAWL_MAX_PAGES=12
CRAWL_MAX_BYTES_PER_PAGE=2097152
CRAWL_TIMEOUT_MS=12000
CRAWL_DELAY_MS=350
CRAWL_USER_AGENT=InterviewPrepKitBot/1.0 (+https://example.invalid/about-bot)

# SSRF gate. Permits loopback and private addresses so the batch harness can
# crawl fixture sites served from http://localhost:8099/.
# IGNORED ENTIRELY WHEN NODE_ENV=production — a deployed instance always blocks
# private addresses regardless of what this is set to.
ALLOW_PRIVATE_NETWORK=true
PRIVATE_NETWORK_ALLOWED_PORTS=8099,3000,8080

# --- Pipeline budgets -----------------------------------------------------
GENERATION_BUDGET_MS=240000
# Batch: per-case deadline and the global cap that keeps a 5-case run inside
# the mandated fifteen minutes.
EVALUATE_CONCURRENCY=3
EVALUATE_CASE_TIMEOUT_MS=150000
EVALUATE_GLOBAL_TIMEOUT_MS=780000
# Cache model responses on disk so repeated runs do not re-spend the free tier.
LLM_CACHE=true

# Emit the optional non-Appendix-A `research` key inside each kit.
# Off by default so exported kits match Appendix A exactly.
KIT_EXTRA_FIELDS=off

# --- API server only (not needed for the batch entry point) ---------------
NODE_ENV=development
PORT=4000
MONGODB_URI=
MONGODB_DB_NAME=interview_prep_kit
# HS256 signing secret, 32+ random bytes. Rotating it signs everyone out.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=24h
COOKIE_NAME=ipk_session
COOKIE_SECURE=false
# Keep this `lax`. If it is ever set to `none`, CSRF tokens become mandatory.
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
JOB_CONCURRENCY=2
JOB_LEASE_MS=120000
LOG_LEVEL=info

# --- Web app only ---------------------------------------------------------
# Server-side only; never expose the backend origin to the browser directly.
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/backend
